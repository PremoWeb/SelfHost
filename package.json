		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-plugin-inspect": "^11.3.3",
		"vitest": "^2.1.9",
		"ws": "^8.19.0"
	},
	"dependencies": {
		"@libsql/client": "^0.17.0",
		"@tanstack/svelte-query": "^5.90.2",
