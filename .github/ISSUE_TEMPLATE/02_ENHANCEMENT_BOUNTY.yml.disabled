name: 💎 Enhancement Request
description: "Propose a new feature, service, or improvement."
title: "[Enhancement]: "
labels: ["✨ Enhancement", "🔍 Triage"]
body:
  - type: markdown
    attributes:
      value: |
        > [!IMPORTANT]
        > **This template is for proposing new features, services, or improvements.**

  - type: dropdown
    attributes:
      label: Request Type
      description: Select the type of request you are making.
      options:
        - New Feature
        - New Service
        - Improvement
    validations:
      required: true

  - type: textarea
    attributes:
      label: Description
      description: Provide a detailed description of the feature, improvement, or service you are proposing.
    validations:
      required: true
