{
	"name": "SelfHost Dev Container",
	"image": "oven/bun:latest",

	// Mount configuration for SQLite databases and data directories
	"mounts": [
		// Named volume for SQLite databases (persists across rebuilds)
		"source=selfhost-sqlite-data,target=${containerWorkspaceFolder}/sqlite-data,type=volume",
		// Named volume for git repositories
		"source=selfhost-git-repos,target=${containerWorkspaceFolder}/data/git-repos,type=volume"
	],

	// Forward ports for development
	"forwardPorts": [5173],
	"portsAttributes": {
		"5173": {
			"label": "Vite Dev Server",
			"onAutoForward": "notify"
		}
	},

	// Install dependencies after container creation
	"postCreateCommand": "bun install",

	// Set up environment variables
	"containerEnv": {
		"DATABASE_URL": "file:${containerWorkspaceFolder}/sqlite-data/sqlite.db",
		"LOGGING_DATABASE_URL": "file:${containerWorkspaceFolder}/sqlite-data/sqlite-logs.db"
	},

	// VS Code customizations
	"customizations": {
		"vscode": {
			"extensions": [
				// Svelte development
				"svelte.svelte-vscode",

				// TypeScript
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",

				// SQLite tools
				"mtxr.sqltools",
				"mtxr.sqltools-driver-sqlite",

				// Tailwind CSS
				"bradlc.vscode-tailwindcss",

				// Git
				"eamodio.gitlens"
			],
			"settings": {
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"[svelte]": {
					"editor.defaultFormatter": "svelte.svelte-vscode"
				},
				"sqltools.connections": [
					{
						"name": "SelfHost Main DB",
						"driver": "SQLite",
						"database": "${containerWorkspaceFolder}/sqlite-data/sqlite.db"
					},
					{
						"name": "SelfHost Logs DB",
						"driver": "SQLite",
						"database": "${containerWorkspaceFolder}/sqlite-data/sqlite-logs.db"
					}
				]
			}
		}
	},

	// Features to install
	"features": {
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
			"installOhMyZsh": true,
			"upgradePackages": true
		}
	},

	// Run as non-root user
	"remoteUser": "bun"
}
